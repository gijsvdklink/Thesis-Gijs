\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Per-step information flow in the experimental environment. Dashed box: hidden delay state $(d,\,t_\text  {el})$ not directly observable by the agent. The two signals derived from the hidden state, $r_\text  {pend}$ and $\Delta \psi _\text  {iss}$, are the only information the agent receives about the pending instruction.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:block}{{2}{5}{Per-step information flow in the experimental environment. Dashed box: hidden delay state $(d,\,t_\text {el})$ not directly observable by the agent. The two signals derived from the hidden state, $r_\text {pend}$ and $\Delta \psi _\text {iss}$, are the only information the agent receives about the pending instruction}{figure.2}{}}
